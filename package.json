{
  "name": "engipro-manager",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check:boundaries": "depcruise apps packages --config tools/.dependency-cruiser.js",
    "check:hooks": "sh tools/block-prototype-writes.test.sh",
    "check:boundaries:self-test": "sh tools/dependency-cruiser.test.sh",
    "check:mining": "sh tools/check-mining-docs.sh",
    "check:cnumbers": "sh tools/check-cnumber-coverage.sh",
    "check:paths": "node tools/path-audit.mjs",
    "check:purity": "sh tools/check-domain-purity.sh",
    "check:no-cdn": "node tools/assert-no-cdn.mjs apps/web/dist/index.html",
    "check:glossary": "node tools/check-glossary.mjs",
    "check:tiers": "node tools/check-module-tiers.mjs",
    "poc:multischema": "node tools/poc/multischema/run.mjs",
    "check:denylist": "node tools/check-dependency-denylist.mjs"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.1.1",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "turbo": "^2.10.9",
    "typescript": "catalog:"
  }
}
